<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>follow_me</name>
  <version>2.0.0</version>
  <description>ROS 2 package for radio based follow me function</description>

  <maintainer email="herold.adam7@gmail.com">Adam Herold</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>follow_me_interfaces</exec_depend>
  <exec_depend>ros2_numpy</exec_depend>
  <exec_depend>sound_play</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>

  <!-- external sensor driver message packages (provided separately) -->
  <exec_depend>dwm1001_ros_interfaces</exec_depend>
  <exec_depend>xplraoa_ros_interfaces</exec_depend>
  <exec_depend>uwb_tdoa_interfaces</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
